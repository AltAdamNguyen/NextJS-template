# =========================================================
# Next.js Production .gitignore
# =========================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build outputs
/.next/
/out/
/build/
/dist/
.turbo/
.swc/

# Environment & Local overrides
# Giữ lại .env.example, .env.development, .env.production
# Bỏ qua tất cả cấu hình local và file ghi đè cá nhân
.env.*
!.env.example

# Secrets, Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Testing & Code Coverage
/coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# IDE & Code Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Operating System & File System metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# TypeScript build info & Next generated type declarations
*.tsbuildinfo
next-env.d.ts

# Cloud & Hosting platforms
.vercel
.serverless/
.netlify/

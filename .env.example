# =========================================================
# .env.example — Template biến môi trường chuẩn Next.js
# Sao chép thành .env.local để ghi đè cấu hình cá nhân
# =========================================================

# Môi trường ứng dụng (development | production)
NEXT_PUBLIC_APP_ENV=

# URL API backend
NEXT_PUBLIC_API_URL=

# Tên hiển thị ứng dụng
NEXT_PUBLIC_APP_NAME=

# URL gốc client của ứng dụng
NEXT_PUBLIC_APP_URL=

# Timeout request (ms)
NEXT_PUBLIC_API_TIMEOUT=

# Khóa bí mật mã hóa / ký số (chỉ inject qua secret manager ở production)
NEXT_PUBLIC_AES_SECRET_KEY=
NEXT_PUBLIC_HMAC_SECRET_KEY=

# URL WebSocket / SignalR cho chatbot AI
NEXT_PUBLIC_SOCKET_URL=
